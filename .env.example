# Copy to .env and adjust. Everything is optional; sensible defaults apply.
PORT=3000
SITE_URL=https://a2z-consultant.com

# Where form enquiries are emailed. Without SMTP settings, enquiries are still saved to data/enquiries.jsonl.
CONTACT_TO=info@a2z-consultant.com
CONTACT_FROM="A to Z Consultants <no-reply@a2z-consultant.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
