<%- include('../partials/phero', { eyebrow: 'Contact', title: forms.contact.excerpt, lead: 'Complete the form and our team will get in touch regarding your enquiry or business requirement.', image: '/wp-content/uploads/2026/05/office-desktop-with-laptop-business-man-scaled.jpg', crumbs: [['Contact']] }) %>

<section class="section contact">
  <div class="wrap contact__grid">
    <div class="contact__form reveal">
      <h2>Send us a message</h2>
      <p class="prose"><%= forms.contact.intro %></p>
      <%- include('../partials/enquiry-form', { formId: 'contact', idPrefix: 'contact', fields: forms.contact.fields, button: forms.contact.button }) %>
    </div>

    <aside class="contact__info reveal" data-delay="1">
      <div class="infocard">
        <h2 class="mono">Reach us directly</h2>
        <ul class="infolist">
          <li><span class="infolist__ico"><svg class="i"><use href="#i-phone"/></svg></span><div><b>Phone</b><a href="tel:<%= site.phoneTel %>"><%= site.phone %></a></div></li>
          <li><span class="infolist__ico"><svg class="i"><use href="#i-mail"/></svg></span><div><b>Email</b><a href="mailto:<%= site.email %>"><%= site.email %></a></div></li>
          <li><span class="infolist__ico"><svg class="i"><use href="#i-pin"/></svg></span><div><b>Office</b><a href="<%= site.mapsUrl %>" target="_blank" rel="noopener"><%= site.address.line1 %>, <%= site.address.line2 %>, <%= site.address.city %>, UAE</a></div></li>
          <li><span class="infolist__ico"><svg class="i"><use href="#i-clock"/></svg></span><div><b>Working days</b><span><%= site.hours %></span></div></li>
        </ul>
      </div>
      <div class="infocard infocard--navy dark">
        <h2>Prefer a structured request?</h2>
        <p>Our four-step consultation form helps us understand your business before we speak.</p>
        <a class="btn btn--sky" href="/get-a-consultation/">Get a consultation <svg class="i"><use href="#i-arrow-right"/></svg></a>
      </div>
    </aside>
  </div>
</section>

<section class="mapband" aria-label="Map">
  <iframe title="A to Z Consultants office location in Deira, Dubai" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://maps.google.com/maps?q=<%= site.geo.lat %>,<%= site.geo.lng %>&z=15&output=embed"></iframe>
</section>
