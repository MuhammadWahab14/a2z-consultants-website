<section class="section result">
  <div class="wrap narrow result__box">
    <span class="result__ico"><svg class="i"><use href="#i-check"/></svg></span>
    <p class="eyebrow">Message received</p>
    <h1>Thank you. We will be in touch shortly.</h1>
    <p class="lead">One of our advisors will review your details and contact you by phone or email. If it is urgent, call us on <a href="tel:<%= site.phoneTel %>"><%= site.phone %></a>.</p>
    <div class="result__actions">
      <a class="btn btn--navy btn--lg" href="/">Back to home</a>
      <a class="btn btn--ghost btn--lg" href="/practice-areas/">Explore our services</a>
    </div>
  </div>
</section>
